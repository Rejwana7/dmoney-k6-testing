BASE_URL=http://localhost:5000
# Set the path to the .env used by your running local backend.
# Limit/index helpers reuse its local dmoneydb credentials and mysql2 driver.
LOCAL_BACKEND_ENV_FILE=

ADMIN_EMAIL=admin@dmoney.com
ADMIN_PASSWORD=replace-with-local-admin-password
SYSTEM_EMAIL=system@dmoney.com
SYSTEM_PASSWORD=replace-with-local-system-password

# Optional overrides: leave blank to read PARTNER_KEY, DEFAULT_OTP and EMAIL_USER
# from LOCAL_BACKEND_ENV_FILE. TEST_MAILBOX must be a Gmail inbox you control.
PARTNER_KEY=
DEFAULT_OTP=
TEST_MAILBOX=
OTP_MODE=dev
USERS_FILE=./config/users.local.json

# Amount per transaction; sender fees are additional.
DEPOSIT_AMOUNT=10
SENDMONEY_AMOUNT=10
PAYMENT_AMOUNT=10

# Seed tops up to these targets; it does not add the full amount every time.
INITIAL_AGENT_BALANCE=20000
INITIAL_CUSTOMER_BALANCE=4500

# Actual normal Customer limits: preflight snapshot, NOT database settings.
# Comparison commands temporarily raise count to >=10000 and amount to >=1000000,
# supply verified values to k6, then restore the originals. Keep normal values here.
DAILY_COUNT_LIMIT=10
MONTHLY_COUNT_LIMIT=50
DAILY_AMOUNT_LIMIT=5000
MONTHLY_AMOUNT_LIMIT=50000
